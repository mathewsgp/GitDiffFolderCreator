<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:GitDiffFolderCreator.Controls"
                    xmlns:behaviors="clr-namespace:GitDiffFolderCreator.Behaviors">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <controls:CommitRoleToVisibilityConverter x:Key="CommitRoleToVisibility" />
    <controls:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <controls:InverseBooleanToVisibilityConverter x:Key="BoolToVisibilityInverted" />
    <controls:FractionToStarConverter x:Key="FractionToStar" />

    <!-- One corner radius for everything the user can click or type into. These controls are all the
         same idea - a thing you interact with - and they were drawn by whatever style happened to
         apply at the time: some square from the system theme, some at three, some at four, and one
         field's shell at six. Side by side they read as controls from three different programs. The
         radius is a resource rather than a repeated number so it cannot drift, and it is small
         enough to stay a box rather than becoming a pill. -->
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <SolidColorBrush x:Key="ControlFill" Color="#F7F8FA" />
    <SolidColorBrush x:Key="ControlBorder" Color="#C6CCD3" />
    <SolidColorBrush x:Key="ControlBorderHover" Color="#9AA4AF" />
    <SolidColorBrush x:Key="ControlFillHover" Color="#EDF0F3" />
    <SolidColorBrush x:Key="ControlFillPressed" Color="#E1E6EB" />
    <SolidColorBrush x:Key="ControlAccent" Color="#2F6FB5" />

    <!-- The inset between a field's edge and the text inside it, shared by the text box and the
         dropdown. One number for both because they sit in the same row and are read as one control:
         the dropdown was previously inset by nothing at all, its own template having dropped the
         padding on the way to a custom chevron, so the two boxes in the filter row held their text at
         visibly different distances from the border.
         Six is what a 12px face needs at this height - enough to clear the border and the corner
         radius, little enough that a short value such as a commit count does not look lost in a
         wide box. -->
    <Thickness x:Key="ControlPadding">6,0</Thickness>

    <!-- The height every interactive control is drawn at. One number rather than a height per
         instance: they were sized by whatever content they held, so a button reading one word came
         out shorter than a button reading two, and a row of them read as a ragged edge. A control
         whose text is longer is now wider rather than taller. Thirty-four is the height the design
         uses, and it is tall enough for a 12px face to sit in with room either side.

         The text boxes and the dropdown carry it too, not because they are buttons but because they
         share rows with them: a 34px button beside a 22px box is worse than either number on its
         own. The two boxes that wrap several lines - the commit body and the run log - declare a
         taller minimum of their own, and a minimum is what beats a height. -->
    <sys:Double x:Key="ControlHeight">34</sys:Double>

    <!-- Every button, unless it says otherwise. The window's own accent is reserved for the export,
         so a plain button wears a quiet fill and only darkens on hover. Applied implicitly rather
         than by key because a button that forgets its style should still look like the others. -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Background" Value="{StaticResource ControlFill}" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlFillHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlFillPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A8AEB5" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Root" Property="Background" Value="#F2F3F5" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#E0E4E8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button that is also a switch. Same geometry as the button above, so the two do not read as
         different families, but the checked state is filled rather than merely darker: a toggle has
         to show its position without being pressed, and a hover colour cannot do that. -->
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Background" Value="{StaticResource ControlFill}" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlAccent}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#25578F" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlFillHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A8AEB5" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Root" Property="Background" Value="#F2F3F5" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#E0E4E8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every text box, unless it says otherwise. The radius matches the buttons so the two read as
         one family, and the whole thing is driven from the template binding so a box that declares
         itself borderless - the output log - still comes out borderless rather than gaining a frame
         it did not ask for. -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <!-- The content host is what the caret, the selection and the scroller are
                             attached to; without it the box takes no input. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderHover}" />
                        </Trigger>
                        <!-- Focus is an accent border rather than a glow, so it does not change the
                             box's size and push the row it sits in sideways. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlAccent}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F7F8FA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A8AEB5" />
                            <Setter TargetName="Root" Property="Background" Value="#F2F3F5" />
                        </Trigger>
                        <!-- Wrapping text is several lines high, so it starts at the top rather than
                             floating in the middle of a box it has already filled. -->
                        <Trigger Property="TextWrapping" Value="Wrap">
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A filter box, drawn with a magnifying glass at its left edge. The icon is drawn rather than
         a glyph so it does not change with the platform's font or theme, and it is inset rather than
         placed outside so the box keeps its own width. The content host's left margin is widened to
         clear it - the icon sits in the padding, so the text still starts where it started, and the
         caret never runs under the glass. -->
    <Style x:Key="SearchBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="26,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />

                            <!-- The glass: a ring with a handle, stroked rather than filled so it stays
                                 the same weight at 14px. The ring is two half-arcs whose
                                 endpoints sit 2 x radius apart, so they close into one
                                 true circle; endpoints any closer would bow the same way
                                 twice and draw a lens instead, which reads as a second
                                 mark rather than as a lens. The handle starts on the
                                 circle at 45 degrees and runs out to the corner. -->
                            <Path Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Stroke="#8A9099" StrokeThickness="1.5"
                                  IsHitTestVisible="False"
                                  Data="M 1.5,5 A 3.5,3.5 0 1 1 8.5,5 A 3.5,3.5 0 1 1 1.5,5 Z M 7.47,7.47 L 11.5,11.5" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlAccent}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F7F8FA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A8AEB5" />
                            <Setter TargetName="Root" Property="Background" Value="#F2F3F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The dropdown, restyled to match. Its own template is unavoidable: the system one draws a
         square box with a separate arrow, which is the mismatch this is here to remove. -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <!-- The toggle is the box, not a hidden control behind one. Drawing the field
                             inside it means the whole area is the hit target and the hover border comes
                             from the same border that draws the field, with no click handler needed to
                             open the list. -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Padding="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource ControlRadius}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- The padding is applied to the border rather than to the
                                                 presenter, so the text starts at the same distance from
                                                 the edge as it does in a text box. The chevron keeps
                                                 its own wider inset so it hangs clear of the corner. -->
                                            <ContentPresenter Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                              VerticalAlignment="Center" />

                                            <!-- A chevron rather than the system's arrow glyph, so it
                                                 matches the branch picker's and is not a different
                                                 drawing at a different size. -->
                                            <Path Grid.Column="1" Margin="6,0,8,0" Width="8" Height="5"
                                                  Stretch="Uniform" VerticalAlignment="Center"
                                                  Fill="#6A7078"
                                                  Data="M 0,0 L 4,4.5 L 8,0 Z" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlBorderHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               PopupAnimation="None">
                            <Border Margin="0,2,0,0" Padding="4" MinWidth="{TemplateBinding ActualWidth}"
                                    Background="White" BorderBrush="#C8CCD1" BorderThickness="1"
                                    CornerRadius="{StaticResource ControlRadius}">
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Focus is an accent border rather than a glow, so it does not change the
                             box's size and push the row it sits in sideways. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource ControlAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#A8AEB5" />
                            <Setter TargetName="Toggle" Property="Background" Value="#F2F3F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One accent for both progress indicators. The log ring and the export bar are the same idea
         told twice, so they share a colour rather than each picking one that drifts. -->
    <SolidColorBrush x:Key="ProgressAccent" Color="#4A7BB7" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#DFE4E9" />

    <!-- The window is one grey surface with four panels on it. A white fill is what lifts a panel off
         that surface; the hairline only has to say where one panel ends and the next begins, so it
         stays lighter than the fill it separates. -->
    <SolidColorBrush x:Key="CardFill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#D8DCE0" />

    <!-- The same card, for the two bands that are plain content rather than a collapsible panel. The
         radius and the padding live here so all four bands are inset by the same amount and none of
         them can drift. -->
    <Style x:Key="PanelCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource CardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A quiet label on the surface. Not every caption needs to be a section heading: the ones
         that sit beside a control are labels, and are sized as such. Shared rather than local to
         the main window, because a window cannot reach another window's resources and the diff
         tool picker labels a control the same way. -->
    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#5A5A5A" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A section heading on the flat surface: small, muted, and letter-spaced, so it reads as a
         label rather than competing with the data underneath it. -->
    <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#6B6B6B" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The pill that names a commit's resolved role. The row it sits in is the place the decision
         was made, so the label belongs there and nowhere else. -->
    <Style x:Key="RolePill" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Role, Converter={StaticResource CommitRoleToVisibility}, ConverterParameter=Base}">
                <Setter Property="Background" Value="#E3EFFA" />
                <Setter Property="BorderBrush" Value="#2F6FB5" />
                <Setter Property="BorderThickness" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Role, Converter={StaticResource CommitRoleToVisibility}, ConverterParameter=Modified}">
                <Setter Property="Background" Value="#E6F4E6" />
                <Setter Property="BorderBrush" Value="#2E7D32" />
                <Setter Property="BorderThickness" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RolePillText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A branch or tag name pointing at a commit. A chip rather than a highlight, so it sits with
         the metadata instead of shouting over the message. -->
    <Style x:Key="RefChip" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="#EDEDED" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="5,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Ref names are the widest thing on the row, and %D packs several of them together
         ("HEAD -> main, origin/main, tag: v1.0.0"). The cap was 150px, which is roughly twenty
         characters: enough for a short branch name and little else, so a repository with a remote
         or a version tag lost the interesting tail - usually the tag - to an ellipsis.
         Raised to 460px, which fits a long branch name plus a tag at the 10px font while still
         stopping the chip from pushing the row wider than the log pane. The tooltip carries the
         untruncated list for anything that still does not fit. -->
    <Style x:Key="RefChipText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#4A4A4A" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="460" />
    </Style>

    <!-- The status letter in the file list, colour coded so the letters need no legend. The tooltip
         carries the full word. -->
    <Style x:Key="StatusBadge" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#EDEDED" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Added">
                <Setter Property="Background" Value="#DCF3DC" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Modified">
                <Setter Property="Background" Value="#FDF0D5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Deleted">
                <Setter Property="Background" Value="#FBDCDC" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Renamed">
                <Setter Property="Background" Value="#DCE7FB" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Copied">
                <Setter Property="Background" Value="#E7F6E7" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="TypeChanged">
                <Setter Property="Background" Value="#FBE8D8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Unmerged">
                <Setter Property="Background" Value="#FBDCDC" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusBadgeText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#333333" />
    </Style>

    <!-- The action that starts the export. It is the one control on the window that is meant to be
         pressed, so it is the only one wearing the accent colour. -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="#2F6FB5" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#25578F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#3B7FC7" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#25578F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="#BFC9D4" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#B4BEC9" />
                            <Setter Property="Foreground" Value="#F0F3F6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An interrupt, not another action. Same geometry as the primary button so the two do not look
         like different families, but outlined and red rather than filled blue: it ends the run
         rather than starting one, and it is the only red control on the window. -->
    <Style x:Key="StopButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#B3261E" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#E0A9A4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FBEDEC" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#B3261E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F5D9D6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#B4BEC9" />
                            <Setter Property="BorderBrush" Value="#E3E6E9" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in the dropdown above. The system row is square and its highlight is a hard-edged band, so
         opening the list showed a different design from the closed box that opened it. -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlFillHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A commit row: hash and message on the first line, author, date and refs on the second. The
         hash stays monospace so the eye can find the start of the next one. -->
    <Style x:Key="CommitRow" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F0F0F0" />
                            <Setter Property="behaviors:RowHover.IsHovered" Value="True" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#DDEAF6" />
                        </Trigger>

                        <!-- A control that appears only on hover cannot be reached by keyboard at all,
                             because it is collapsed exactly when the user is not pointing at it. Focus
                             counts as hovering, so the row the keyboard is on still shows its button. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="behaviors:RowHover.IsHovered" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A file row. Dimmed rather than hidden when unticked, so the exclusion is visible and can be
         undone without hunting for the row. -->
    <Style x:Key="FileRow" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F0F0F0" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#DDEAF6" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A DevExpress LayoutControl used as a group container: no frame, a caption on the surface, and a
         hairline rule across the full width under it. Everything is flat, so the rule is the only
         thing separating one panel's content from the next. -->
    <Style x:Key="PanelCaption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#2F2F2F" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PanelRule" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#D3D3D3" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <!-- Keyboard focus has to be visible on a flat surface, so the rule picks up the accent
                 colour instead of a frame that the design does not have. -->
            <DataTrigger Value="True"
                         Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=controls:CollapsibleGroupBox}}">
                <Setter Property="Background" Value="#4A7BB7" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The chevron is a hairline that rotates a quarter turn when the panel opens, so the collapsed
         state is readable without relying on colour alone. -->
    <Geometry x:Key="ChevronGeometry">M 0,0 L 5,4.5 L 0,9</Geometry>

    <Style x:Key="Chevron" TargetType="{x:Type Path}">
        <Setter Property="Data" Value="{StaticResource ChevronGeometry}" />
        <Setter Property="Stroke" Value="#7A7A7A" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="0.4,0.5" />
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <!-- Hidden on a panel that cannot fold, so the affordance is not advertised falsely. -->
        <Setter Property="Visibility"
                Value="{Binding IsCollapsible, RelativeSource={RelativeSource AncestorType=controls:CollapsibleGroupBox}, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="{Binding Path=(controls:CollapsibleGroupBox.ChevronAngle),
                                              RelativeSource={RelativeSource AncestorType=controls:CollapsibleGroupBox}}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The header is a ToggleButton so focus, tab order and Space/Enter come from the platform
         rather than being reimplemented. The template suppresses the chrome and leaves a hover
         tint, the way a DevExpress header reacts. -->
    <Style x:Key="PanelHeaderToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4,0,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0" />
                                    </Trigger>
                                    <!-- IsChecked belongs to the ToggleButton, not to this Border, so
                                         it has to be reached through the templated parent. -->
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Setter Property="Background" Value="#F5F5F5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- A panel that cannot fold must not look like it can. Placed after the property elements
             because XAML requires property elements to precede content. -->
        <Style.Triggers>
            <DataTrigger Value="False"
                         Binding="{Binding IsCollapsible, RelativeSource={RelativeSource AncestorType=controls:CollapsibleGroupBox}}">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Focusable" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:CollapsibleGroupBox}">
        <!-- The card. HeaderedContentControl already carries Background, BorderBrush,
             BorderThickness and Padding, so the frame comes from the framework rather than from
             properties invented for it. -->
        <Setter Property="Background" Value="{StaticResource CardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,12" />
        <!-- The card's own padding now insets the content, so the body adds nothing on top of it. -->
        <Setter Property="BodyPadding" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CollapsibleGroupBox}">
                    <!-- The frame wraps the header as well as the body, so a caption sits inside the
                         card rather than perched on its edge. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Collapsed rather than simply hidden, so a headerless panel leaves no row
                             behind. -->
                        <ToggleButton x:Name="Header" Grid.Row="0" Style="{StaticResource PanelHeaderToggle}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      IsEnabled="{TemplateBinding IsCollapsible}"
                                      Visibility="{TemplateBinding ShowHeader, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Chevron}" />
                                <!-- Header is expected to be text, which buys TextTrimming; a
                                     non-text header would be rendered with ToString. -->
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource PanelCaption}"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- The rule belongs to the header: with no caption there is nothing for it
                             to divide. -->
                        <Border x:Name="Rule" Grid.Row="1" Style="{StaticResource PanelRule}"
                                Visibility="{TemplateBinding ShowHeader, Converter={StaticResource BoolToVisibility}}" />

                        <ContentPresenter x:Name="Body" Grid.Row="2"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding BodyPadding}">
                            <ContentPresenter.Style>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Style.Triggers>
                                        <!-- Collapsed: the body takes no space at all, so the row
                                             above it collapses too rather than leaving a gap. -->
                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:CollapsibleGroupBox}}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A headerless panel has no caption and no rule to clear, but it is still a card, so it is
         inset like one and given a little more room because its rows carry their own labels and would
         otherwise read as crowded against the frame. It cannot fold either, so the chevron and the
         toggle are gone and the content is always on show. -->
    <Style x:Key="PanelHeaderless" TargetType="{x:Type controls:CollapsibleGroupBox}"
           BasedOn="{StaticResource {x:Type controls:CollapsibleGroupBox}}">
        <Setter Property="ShowHeader" Value="False" />
        <Setter Property="IsCollapsible" Value="False" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- A card that carries its own caption: the header needs the rule beneath it, and the body below
         the rule is a single text box rather than a stack of rows, so the sides are tightened a
         little to stop the log looking like it is floating. -->
    <Style x:Key="PanelCaptioned" TargetType="{x:Type controls:CollapsibleGroupBox}"
           BasedOn="{StaticResource {x:Type controls:CollapsibleGroupBox}}">
        <Setter Property="Padding" Value="14,8,14,10" />
    </Style>

</ResourceDictionary>
