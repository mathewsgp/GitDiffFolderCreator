<Window x:Class="GitDiffFolderCreator.ChangeDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify change document" Height="660" Width="820"
        MinHeight="520" MinWidth="680"
        FontSize="14"
        Background="#F7F7F7"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What this is for, in one line. The check is only meaningful against a document and two
             copies of the same source tree, so saying that here is cheaper than a heading elsewhere. -->
        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="#4A4A4A" FontSize="12"
                   Text="Point at the source tree before the changes, the source tree after them, and the Word document that lists the changed files. Every difference between the two folders is compared with what the document says." />

        <!-- The three inputs. Labelled above their controls rather than beside them, so a long path
             has the whole width and the pair does not have to be inferred. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionHeading}" Margin="0,0,0,6"
                               Text="BASE SOURCE" />
                    <TextBox VerticalContentAlignment="Center"
                             ToolTip="The source tree before the changes."
                             Text="{Binding BaseFolder, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" VerticalAlignment="Bottom"
                        Content="Browse..." Command="{Binding BrowseBaseCommand}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionHeading}" Margin="0,0,0,6"
                               Text="MODIFIED SOURCE" />
                    <TextBox VerticalContentAlignment="Center"
                             ToolTip="The source tree containing the changes."
                             Text="{Binding ModifiedFolder, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" VerticalAlignment="Bottom"
                        Content="Browse..." Command="{Binding BrowseModifiedCommand}" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionHeading}" Margin="0,0,0,6"
                               Text="CHANGE DOCUMENT" />
                    <TextBox VerticalContentAlignment="Center" FontFamily="Consolas"
                             ToolTip="The Word document listing the files that were changed."
                             Text="{Binding DocumentPath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" VerticalAlignment="Bottom"
                        Content="Browse..." Command="{Binding BrowseDocumentCommand}" />
            </Grid>
        </Grid>

        <!-- Build output differs on every build, so including it would report every project as changed
             and bury the changes. Off is the wrong default for a source tree, which is why this is a
             checkbox the reader can clear rather than a hidden rule. -->
        <CheckBox Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center"
                  Content="Ignore bin, obj, .vs, .git and similar"
                  IsChecked="{Binding IgnoreBuildOutput}" />

        <!-- The verdict and the findings. Both hidden until there is something to say, so the window
             does not present an empty result as a pass. -->
        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource PanelCard}"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeading}" Text="RESULT" />

                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="#2E7D32"
                           Visibility="{Binding VerdictIsGood, Converter={StaticResource BoolToVisibility}}"
                           Text="{Binding VerdictCaption}" />

                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="#C62828"
                           Visibility="{Binding VerdictIsGood, Converter={StaticResource BoolToVisibilityInverted}}"
                           Text="{Binding VerdictCaption}" />

                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#5A5A5A" TextWrapping="Wrap"
                           Text="{Binding Summary}" />

                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#7A7A7A" TextWrapping="Wrap"
                           Text="{Binding DetailLine}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap"
                   FontSize="12" Foreground="#C62828"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                   Text="{Binding Error}" />

        <!-- The findings, one row each. Wrapping rather than trimming because the path is the thing
             being read and a truncated path cannot be checked against a folder. -->
        <ListView Grid.Row="4" Margin="0,12,0,0"
                  Background="#FFFFFF"
                  BorderBrush="#D8DCE0" BorderThickness="1"
                  ItemsSource="{Binding Findings}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Kind" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Text="{Binding KindCaption}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Path" Width="270">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Text="{Binding DisplayPath}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="What is wrong" Width="330">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="#4A4A4A"
                                           TextWrapping="Wrap" Text="{Binding Detail}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#7A7A7A"
                       TextWrapping="Wrap"
                       Text="Experimental. Compares folders on disk; it knows nothing about commits or the export." />

            <!-- Taking the list somewhere else. The findings are what gets worked through, and
                 re-typing them out of a window is where the transcription errors come from. -->
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,3"
                    ToolTip="Copy the findings to the clipboard as CSV."
                    Content="Copy CSV"
                    Command="{Binding CopyReportCommand}" />

            <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,3"
                    ToolTip="Save the findings to a .csv or .txt file."
                    Content="Export..."
                    Command="{Binding ExportReportCommand}" />

            <Button Grid.Column="3" Margin="8,0,0,0" Padding="16,3"
                    Content="{Binding VerifyCaption}"
                    Command="{Binding VerifyCommand}"
                    IsDefault="True" />

            <Button Grid.Column="4" Margin="8,0,0,0" Padding="16,3"
                    Content="Close" IsCancel="True" />
        </Grid>
    </Grid>
</Window>